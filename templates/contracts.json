{
  "contracts": [
    {
      "name": "profile-scribe.source-record",
      "version": "1.0.0",
      "description": "Normalized crawl result for a user-supplied URL.",
      "fields": [
        { "name": "url", "type": "url", "required": true },
        { "name": "status", "type": "enum", "required": true, "values": ["crawled", "failed"] },
        { "name": "title", "type": "string" },
        { "name": "canonicalUrl", "type": "url" },
        { "name": "author", "type": "string" },
        { "name": "publishedAt", "type": "date" },
        { "name": "summary", "type": "string" },
        { "name": "facts", "type": "array" },
        { "name": "failure", "type": "string" }
      ]
    },
    {
      "name": "profile-scribe.voice-profile",
      "version": "1.0.0",
      "description": "Compact style profile derived from previous posts.",
      "fields": [
        { "name": "version", "type": "string", "required": true },
        { "name": "confidence", "type": "enum", "required": true, "values": ["low", "medium", "high"] },
        { "name": "signals", "type": "array", "required": true },
        { "name": "avoid", "type": "array" },
        { "name": "samplePostIds", "type": "array" }
      ]
    },
    {
      "name": "profile-scribe.post-draft",
      "version": "1.0.0",
      "description": "Fresh draft ready for Profile Scribe review or submission.",
      "fields": [
        { "name": "title", "type": "string" },
        { "name": "body", "type": "string", "required": true },
        { "name": "sourceUrls", "type": "array" },
        { "name": "priorPostIds", "type": "array" },
        { "name": "duplicateRisk", "type": "enum", "values": ["low", "medium", "high"] },
        { "name": "status", "type": "enum", "required": true, "values": ["drafted", "reviewed", "submitted"] }
      ]
    },
    {
      "name": "profile-scribe.submission-receipt",
      "version": "1.0.0",
      "description": "Receipt returned by Profile Scribe after staging or publishing.",
      "fields": [
        { "name": "status", "type": "enum", "required": true, "values": ["draft", "review", "published", "failed"] },
        { "name": "postId", "type": "string" },
        { "name": "url", "type": "url" },
        { "name": "submittedAt", "type": "datetime" },
        { "name": "failure", "type": "string" }
      ]
    },
    {
      "name": "profile-scribe.opportunity-tournament-job",
      "version": "1.0.0",
      "description": "Research-only worker input for selecting one evidence-grounded professional opportunity.",
      "fields": [
        { "name": "id", "type": "string", "required": true },
        { "name": "kind", "type": "enum", "required": true, "values": ["opportunity_tournament"] },
        { "name": "tenantId", "type": "string", "required": true },
        { "name": "userId", "type": "string", "required": true },
        { "name": "payload.tournamentId", "type": "string", "required": true },
        { "name": "payload.objective", "type": "object", "required": true },
        { "name": "payload.budget", "type": "object", "required": true },
        { "name": "payload.evidenceSnapshot", "type": "object" },
        { "name": "payload.priorOutcomes", "type": "array" },
        { "name": "payload.candidates", "type": "array" },
        { "name": "payload.researchOnly", "type": "boolean", "required": true }
      ]
    },
    {
      "name": "profile-scribe.opportunity-tournament-result",
      "version": "3.0.0",
      "description": "Compact incremental-income tournament receipt stored by the ProfileScribe worker; it authorizes no outreach, enrichment, publishing, or provider write.",
      "fields": [
        { "name": "status", "type": "enum", "required": true, "values": ["completed", "skipped"] },
        { "name": "jobId", "type": "string", "required": true },
        { "name": "jobKind", "type": "enum", "required": true, "values": ["opportunity_tournament"] },
        { "name": "artifactType", "type": "enum", "required": true, "values": ["opportunity_tournament_result"] },
        { "name": "artifactId", "type": "string", "required": true },
        { "name": "metadata.objective", "type": "object", "required": true },
        { "name": "metadata.hypotheses", "type": "array", "required": true },
        { "name": "metadata.hypotheses[].expectedValueMicros", "type": "integer", "required": true },
        { "name": "metadata.hypotheses[].revenuePath", "type": "object", "required": true },
        { "name": "metadata.hypotheses[].revenuePath.contractVersion", "type": "enum", "required": true, "values": ["incremental_revenue_v2"] },
        { "name": "metadata.candidates", "type": "array", "required": true },
        { "name": "metadata.winner", "type": "object" },
        { "name": "metadata.winner.candidateId", "type": "string" },
        { "name": "metadata.runnerUp", "type": "object" },
        { "name": "metadata.searchSpace", "type": "object", "required": true },
        { "name": "metadata.searchSpace.revenueGate", "type": "enum", "required": true, "values": ["incremental_income_v2"] },
        { "name": "metadata.searchSpace.revenuePathContract", "type": "enum", "required": true, "values": ["incremental_revenue_v2"] },
        { "name": "metadata.searchSpace.revenueRejectedCount", "type": "integer", "required": true },
        { "name": "metadata.searchSpace.revenueRejectionReasons", "type": "object", "required": true },
        { "name": "metadata.gate", "type": "object", "required": true },
        { "name": "metadata.gate.winnerHypothesisId", "type": "string" },
        { "name": "metadata.usage", "type": "object", "required": true }
      ]
    }
  ]
}
